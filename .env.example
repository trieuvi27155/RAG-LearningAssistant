# Sao chép file này thành ".env" nếu muốn đổi giá trị mặc định trong config.py.
# Không bắt buộc phải có file .env - thiếu biến nào thì config.py dùng giá trị mặc định của biến đó.

# --- Embedding (model đa ngôn ngữ, chạy local) ---
# Model retrieval bất đối xứng (query/passage), giới hạn 512 token, ~1.1GB.
# Chọn bản BASE (768 chiều) vì bản small hụt hẳn khi hỏi CHÉO NGÔN NGỮ - đo trên corpus
# thật: MRR chéo ngôn ngữ 0.364 (small) so với 0.738 (base), cùng ngôn ngữ 0.808 -> 0.829.
# Cái giá là +217 giây một lần lúc build index; lúc hỏi thì gần như không đổi.
# Đổi sang intfloat/multilingual-e5-small nếu máy yếu RAM và chấp nhận chéo ngôn ngữ kém hơn.
# LƯU Ý: đổi model thì PHẢI bấm "Build lại Index", nếu không kết quả truy xuất sẽ sai.
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_BATCH_SIZE=64

# --- Chunking ---
# Đo bằng ĐÚNG tokenizer của embedding model ở trên (không phải tiktoken).
# Tự động hạ xuống nếu vượt giới hạn của model, nên không sợ đặt quá tay.
CHUNK_SIZE_TOKENS=160
CHUNK_OVERLAP_TOKENS=32

# --- Nhận diện tiêu đề (cắt chunk theo ranh giới ngữ nghĩa) ---
# DOCX/PPTX dùng metadata cấu trúc thật nên chắc chắn; PDF phải suy đoán từ cỡ chữ nên có
# thể sai. Tắt (0) nếu thấy nó gây hại trên một loại tài liệu cụ thể.
# LƯU Ý: đổi giá trị này thì phải Build lại Index (nó đổi cách chunk được cắt).
BAT_NHAN_DIEN_TIEU_DE=1
# Dòng phải to hơn cỡ chữ áp đảo của trang bao nhiêu lần VÀ ngắn hơn bao nhiêu ký tự.
TY_LE_KICH_THUOC_CHU_TIEU_DE=1.15
DO_DAI_TOI_DA_TIEU_DE=90

# --- Hình ảnh ---
# Trích ảnh ra data/images/ và gắn với chú thích lân cận ("Hình 3: ..."). Rẻ, bật mặc định.
BAT_TRICH_ANH=1
# Cho model vision ĐỌC nội dung bên trong hình (nhãn sơ đồ, số trên biểu đồ) rồi viết thành
# text tìm kiếm được. MẶC ĐỊNH BẬT: đo thực tế 1.9 giây/hình khi model đã nạp, tức 291 ảnh
# chỉ tốn ~9 phút - rẻ hơn nhiều so với ước lượng ban đầu (30 giây/hình, do đo nhầm cả thời
# gian nạp model). Nhớ pull model trước: ollama pull qwen2.5vl:3b
# Tắt (0) nếu chưa pull model vision.
# LƯU Ý: đổi giá trị này thì phải Build lại Index.
BAT_CHU_THICH_ANH=1
VISION_MODEL_NAME=qwen2.5vl:3b
VISION_NUM_PREDICT=400

# --- Retrieval ---
# Số đoạn trích đưa vào prompt. HẠ TỪ 6 XUỐNG 4 vì lý do TỐC ĐỘ, không phải chất lượng:
# sau khi khai báo OLLAMA_NUM_CTX, prefill nạp toàn bộ prompt thật nên chậm thêm ~10-20 giây
# mỗi câu trên CPU. Đặt lại 6 nếu ưu tiên độ chính xác (máy có GPU thì nên để 6).
# ĐỪNG hạ OLLAMA_NUM_CTX để lấy lại tốc độ - đó là tái tạo lại bug prompt bị cắt im lặng.
TOP_K=4
# Trọng số nhánh BM25 khi hợp nhất với nhánh vector. 0 = tắt (MẶC ĐỊNH), 1.0 = ngang dense.
# Mặc định TẮT sau khi đo trên corpus song ngữ thật: BM25 không giúp gì ngay cả trên câu hỏi
# toàn từ khoá hiếm (dense đã đạt MRR 1.000), nhưng làm hỏng nặng truy xuất chéo ngôn ngữ
# (MRR 0.703 -> 0.536) vì nó khớp nhầm sang tài liệu cùng ngôn ngữ với câu hỏi.
# Xem số đo đầy đủ trong config.py. Bật lại thì nên đo trước, đừng bật theo cảm tính.
TRONG_SO_BM25=0.0
# BM25 ở vai trò CỨU HỘ (recall-only): bơm thêm N ứng viên vào tập đưa đi rerank với điểm
# RRF = 0, tức chúng KHÔNG tự đẩy được thứ hạng - cross-encoder quyết định. Cách này giữ
# lợi ích của BM25 (đoạn chứa từ khoá hiếm / mã định danh / tên riêng OOV chắc chắn có mặt)
# mà tránh đúng cơ chế đã đo là gây hại ở TRONG_SO_BM25. Đặt 0 để tắt hẳn.
SO_UNG_VIEN_BM25_CUU_HO=10
# Độ dài tối đa (ký tự) của mỗi đoạn trích dựng quanh chunk khớp nhất.
NGAN_SACH_KY_TU_MOI_DOAN=1600
# Cho phép đoạn trích mở rộng QUA ranh giới trang trong cùng một tài liệu. Cần cho PDF văn
# bản chảy liên tục: một định nghĩa bắt đầu cuối trang 12 và kết thúc đầu trang 13 sẽ không
# bao giờ được nối lại nếu chặn cứng trong một trang. Trích dẫn vẫn ghi trang của chunk neo.
MO_RONG_QUA_RANH_GIOI_TRANG=1
# Số trang tối đa được vượt qua ở mỗi hướng. Chốt chặn cho slide: không có nó, một slide
# thưa chữ sẽ hút thêm 2-3 slide xung quanh cho đầy ngân sách ký tự.
SO_TRANG_TOI_DA_MO_RONG=1
# Trần số đoạn trích lấy từ cùng 1 trang - tránh dồn hết suất vào 1 trang với tài liệu dài.
# Trần này THÍCH ỨNG: chỉ áp dụng khi ứng viên trải ra đủ nhiều trang. Với câu hỏi mà toàn
# bộ câu trả lời nằm gọn trong một trang, ép lấy đoạn từ trang khác chỉ làm loãng ngữ cảnh.
SO_DOAN_TOI_DA_MOI_TRANG=2
# Số ứng viên đầu bảng dùng để đo độ đa dạng trang trước khi quyết định có áp trần hay không.
# Đặt 0 để tắt phần thích ứng (luôn áp trần cứng như bản trước).
SO_UNG_VIEN_XET_DA_DANG_TRANG=20
# Trần số đoạn LÀ ẢNH trong kết quả. Khi bật chú thích ảnh bằng vision, mô tả ảnh khá dài
# nên với tài liệu nhiều hình chúng lấn át các trang văn bản đúng. Đo thực tế: không trần
# -> Recall@K 0.92; trần 2 -> 0.93; trần 1 -> 0.95 (mốc khi tắt vision là 0.96), mà hình
# vẫn xếp hạng 1 cho câu hỏi về nội dung hình.
SO_DOAN_ANH_TOI_DA=1
# Sàn lọc rác (KHÔNG phải ngưỡng phát hiện lạc đề - xem giải thích chi tiết trong
# config.py): đặt thấp có chủ đích, vì câu hỏi đúng chủ đề hỏi bằng tiếng Anh có thể chỉ
# đạt cosine ~0.79 - cao hơn con số này sẽ loại nhầm câu hỏi tiếng Anh hợp lệ.
# Ngưỡng phụ thuộc họ model: ~0.70 cho họ E5, ~0.20 cho paraphrase-multilingual-MiniLM.
# HẠ TỪ 0.70 XUỐNG 0.50: cosine của E5 không phải thang đo tuyệt đối, một corpus mới (nhiều
# bảng, nhiều công thức) dịch cả phân bố xuống và ngưỡng cố định bắt đầu cắt oan. Vai trò
# chính chuyển sang ngưỡng TƯƠNG ĐỐI ngay bên dưới; 0.50 chỉ còn để chặn rác.
NGUONG_DIEM_TOI_THIEU=0.50
# Ngưỡng TƯƠNG ĐỐI: giữ đoạn có cosine >= (cosine cao nhất của LƯỢT ĐÓ) x tỷ lệ này. Phân
# bố cosine trôi theo domain, tỷ lệ giữa các đoạn trong cùng một lượt thì không.
# 0.78 = chính điểm hiệu chỉnh cũ viết lại theo thang tương đối (0.70 / 0.90 top cosine),
# nên trên corpus cũ hành vi gần như không đổi. Đặt 0 để tắt tầng lọc này.
TY_LE_GIU_SO_VOI_DIEM_CAO_NHAT=0.78
# Ghi log phân bố điểm mỗi lượt truy xuất (cosine từng đoạn, rerank cao nhất, số đoạn sống
# sót). Bật khi cần trả lời "ngưỡng có đang cắt oan trên corpus này không" bằng số đo.
LOG_PHAN_BO_DIEM=0
# Số nguồn tối đa hiển thị dưới mỗi câu trả lời.
SO_TRICH_DAN_HIEN_THI=3

# --- Xếp hạng lại bằng cross-encoder (rerank) ---
# Tầng lọc thứ hai sau tìm kiếm lai. Đo thực tế trên câu hỏi diễn đạt tự nhiên:
# tắt -> MRR 0.417 (0.02s) | 8 ứng viên -> 0.542 (1.5s) | 30 ứng viên -> 0.642 (6.1s).
# Lần đầu bật sẽ tải model ~2.2GB từ HuggingFace.
# Hằng số Reciprocal Rank Fusion khi hợp nhất 2 nhánh tìm kiếm (60 là giá trị chuẩn).
RRF_K=60

BAT_RERANK=1
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
SO_UNG_VIEN_RERANK=30
# Ngưỡng TỪ CHỐI dựa trên điểm rerank - thứ mà ngưỡng cosine ở trên KHÔNG làm được.
# Đặt THẤP có chủ đích: trên corpus SONG NGỮ, câu hỏi chéo ngôn ngữ hợp lệ (hỏi tiếng Việt
# về tài liệu tiếng Anh) chỉ đạt ~0.002-0.005, chồng lấn vùng điểm của câu lạc đề. Ngưỡng
# cao sẽ từ chối oan chính những câu đó, tức hy sinh khả năng song ngữ. 0.001 chặn được
# nhóm lạc đề rõ ràng nhất, phần còn lại giao cho quy tắc từ chối của LLM.
# Đặt 0 để tắt hẳn tuyến phòng thủ này.
NGUONG_DIEM_RERANK_TOI_THIEU=0.001

# --- LLM qua Ollama (local, không dùng API trả phí) ---
OLLAMA_MODEL=qwen3:4b
OLLAMA_HOST=http://localhost:11434
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_PREDICT=12000
# CỬA SỔ NGỮ CẢNH - BẮT BUỘC khai báo. Ollama mặc định cấp 4096 token bất kể model hỗ trợ
# bao nhiêu (qwen3:4b hỗ trợ 262144), và khi prompt vượt quá thì nó KHÔNG báo lỗi mà cắt IM
# LẶNG từ ĐẦU phần ngữ cảnh - tức xoá đúng các đoạn trích [1], [2] liên quan nhất. Với
# TOP_K=6 và NGAN_SACH_KY_TU_MOI_DOAN=1600, prompt đã ~4900 token, một mình đã vượt 4096.
# Hai triệu chứng của bug này (câu trả lời ngắn cụt + "truy xuất kém trên tài liệu mới")
# trông như hai lỗi khác nhau nên rất dễ chẩn đoán nhầm.
# Cái giá: KV-cache tỉ lệ tuyến tính với num_ctx (thêm vài trăm MB RAM, prefill chậm hơn).
# Nếu quá chậm thì hạ TOP_K hoặc NGAN_SACH_KY_TU_MOI_DOAN, ĐỪNG hạ num_ctx.
OLLAMA_NUM_CTX=16384
# Trần cứng khi cửa sổ được nới ĐỘNG theo độ dài prompt - chốt chặn RAM.
OLLAMA_NUM_CTX_TOI_DA=32768
# Ngân sách token dành riêng cho thinking + câu trả lời, cộng vào độ dài prompt khi tính
# num_ctx động. qwen3:4b đã đo sinh hơn 4000 token thinking cho câu hỏi "liệt kê đầy đủ".
OLLAMA_DU_PHONG_TOKEN_SINH=4000
# Số ký tự trên một token, dùng để ƯỚC LƯỢNG độ dài prompt (hệ thống không có tokenizer của
# LLM). Đặt thấp hơn giá trị đo được cho tiếng Việt (~2.5) để luôn ước lượng DƯ.
SO_KY_TU_MOI_TOKEN_UOC_LUONG=2.2
# Bật chế độ suy luận của model riêng cho câu hỏi kiểm chứng khẳng định ("... đúng không?").
# Chậm hơn vài giây nhưng là thứ giúp model phát hiện được khẳng định sai thay vì gật đầu.
BAT_THINKING_KHI_KIEM_CHUNG=1

# --- OCR dự phòng cho trang PDF đọc hỏng ---
# Đọc lại trang bằng model vision khi việc trích xuất text đã thất bại: PDF nhúng font
# không kèm bảng ánh xạ ToUnicode (chữ ra thành mã "(cid:NN)", hay gặp với font toán học),
# hoặc trang scan không có chữ nào.
# MẶC ĐỊNH BẬT, và đây là một quyết định đã bị ĐẢO NGƯỢC sau khi gặp hậu quả thật (§5.49).
# Bản trước để TẮT với lý do "chi phí lớn, lợi ích hẹp" - đúng với bộ tài liệu lúc đó, và sai
# hoàn toàn khi người dùng nạp vào một giáo trình 383 trang dạng PDF SCAN: index build "thành
# công" với 379 chunk mà mỗi chunk chỉ chứa đúng chuỗi "[HÌNH]", không lỗi nào báo ra.
# Bật lại an toàn chứ không phải đánh đổi: chỉ trang nào ĐO ĐƯỢC là không đọc được mới bị
# OCR, nên tài liệu có lớp text bình thường tốn ĐÚNG 0 chi phí.
# LƯU Ý: đổi giá trị này thì phải Build lại Index.
BAT_OCR_DU_PHONG=1
SO_CID_TOI_THIEU_DE_OCR=5
TY_LE_CID_DE_OCR=0.02
SO_TU_TOI_THIEU_TRANG_CO_CHU=15
OCR_NUM_PREDICT=1200
DPI_RENDER_TRANG_OCR=150

# --- Đọc lại trang PDF bị DÍNH CHỮ ---
# pdfplumber quyết định "có khoảng trắng giữa 2 ký tự hay không" bằng x_tolerance (mặc định
# 3 điểm). Với font đặt sát nhau - điển hình là Computer Modern của sách LaTeX - khoảng cách
# thật nhỏ hơn 3 điểm nên MỌI khoảng trắng bị nuốt ("whichareknownasthenormalequations...").
# Hậu quả: vector lệch, BM25 mất từ khoá, và LLM-as-judge chấm sai (đúng nguyên nhân của
# Faithfulness 0.33 ở §5.38).
# Chỉ trang nào ĐO ĐƯỢC là dính mới được đọc lại - hạ x_tolerance cho cả hệ thống thì lại
# chèn khoảng trắng vào GIỮA từ ở những file đang đọc tốt (đã đo trên corpus thật).
# LƯU Ý: đổi giá trị này thì phải Build lại Index.
BAT_DOC_LAI_TRANG_DINH_CHU=1
# CÁC MỨC ĐEM RA DÒ, không phải giá trị chốt cứng: mức tốt nhất phụ thuộc font và cỡ chữ
# từng tài liệu. Mỗi trang tự chọn mức của nó, và chỉ nhận khi vừa đỡ dính hơn vừa không
# làm vỡ từ thêm quá MUC_TANG_TU_LE_CHAP_NHAN.
CAC_X_TOLERANCE_THU=2.0,1.5,1.0,0.7
MUC_TANG_TU_LE_CHAP_NHAN=0.03
TY_LE_DINH_CHU_DE_DOC_LAI=0.10
# 25 chứ không phải 15: ở mức 15, từ ghép kỹ thuật hợp lệ ("Backpropagation") đã bị tính oan.
DO_DAI_CUM_DINH_CHU=25
# Dưới ngần này ký tự chữ thì không kết luận gì - mẫu quá nhỏ để tính tỉ lệ, và trang ít chữ
# đến thế cũng không đáng đọc lại.
SO_KY_TU_TOI_THIEU_DE_DO=200

# --- Đọc PDF bố cục NHIỀU CỘT ---
# pdfplumber đọc theo DÒNG NGANG chạy suốt bề ngang trang, nên với trang chia 2 cột nó ghép
# câu của cột trái vào câu của cột phải thành một câu vô nghĩa - mọi chunk sinh ra từ trang đó
# đều hỏng, và không có dấu hiệu nào để nhận ra (§5.51). Bố cục nhiều cột phổ biến ở báo, tạp
# chí khoa học và một số giáo trình.
# Rãnh giữa cột chỉ được công nhận khi có chữ ở CẢ HAI BÊN và nằm trong khối chữ - nếu không
# sẽ nhận nhầm lề trang thành rãnh và cắt đôi tài liệu một cột (§5.50).
# LƯU Ý: đổi giá trị này thì phải Build lại Index.
BAT_DOC_THEO_COT=1

# --- Hiển thị câu trả lời theo luồng (streaming) ---
# Không làm model nhanh hơn (tổng vẫn 35-70 giây trên CPU) nhưng đưa dấu hiệu đầu tiên về
# ~2 giây thay vì một spinner đứng yên suốt cả phút. Tắt nếu chạy sau proxy hay cắt kết nối
# HTTP đang mở.
BAT_STREAMING=1
# Giãn cách tối thiểu giữa 2 lần vẽ lại khung chat (giây). Vẽ theo từng token làm nghẽn
# trình duyệt mà mắt người cũng không đọc kịp.
GIAN_CACH_VE_LAI_GIAY=0.12
# Số ký tự cuối của phần suy luận nội bộ hiện trong khung trạng thái (suy luận của qwen3:4b
# dài ~15.000 ký tự - hiện hết thì khung chat bị đẩy đi mất).
SO_KY_TU_SUY_LUAN_HIEN=500

# --- Độ tin cậy của chính LLM-as-judge ---
# temperature=0 KHÔNG khiến giám khảo tất định: đo trực tiếp trên qwen3:4b, cùng một prompt
# cùng một ca, 8 lần chấm cho [0, 1, 1, 1, 1, 1, 1, 1]. Không xử lý thì hai lần chạy đánh
# giá trên CÙNG một phiên bản code đã ra hai con số khác nhau, và mọi so sánh "trước/sau khi
# sửa" thành ra vô nghĩa. Chấm 3 lần lấy trung vị; đặt 1 nếu chỉ chạy thử nhanh (nhưng đừng
# lấy con số đó đi so sánh với lần chạy khác).
SO_LAN_CHAM_FAITHFULNESS=3
# Ngưỡng để đánh dấu một điểm Faithfulness là ĐÁNG NGỜ: giám khảo chấm thấp ĐỒNG THỜI mọi
# câu của câu trả lời đều có nguyên văn trong ngữ cảnh - hai điều không thể cùng đúng.
NGUONG_DIEM_JUDGE_THAP=0.5
NGUONG_BAM_NGU_CANH_DE_NGHI_NGO=0.30

# --- Evaluation (LLM-as-judge dùng chung model với OLLAMA_MODEL) ---
JUDGE_MODEL=qwen3:4b


# ============================================================
# NGỮ CẢNH HỘI THOẠI: viết lại câu hỏi nối tiếp trước khi truy xuất
# ============================================================
# Truy xuất vốn chỉ nhìn thấy ĐÚNG câu hỏi hiện tại. Một câu nối tiếp kiểu "Thế còn phần thứ
# hai thì sao?" không mang chủ đề nào trong bản thân nó, nên vector của nó không trỏ tới đâu
# cả. Lịch sử chat tuy hiện trên màn hình nhưng nằm ở tầng giao diện, chưa bao giờ đi vào
# truy xuất - đây là giới hạn của kiến trúc single-turn, xảy ra NGAY TRONG MỘT PHIÊN (khác
# hẳn chuyện không lưu lịch sử qua nhiều phiên, vốn là phạm vi đã chốt).
#
# Cách MẶC ĐỊNH - hoàn toàn TẤT ĐỊNH, không gọi model: nhận diện câu nối tiếp rồi GHÉP các
# câu hỏi trước vào làm một truy vấn phụ để RRF hợp nhất. Chi phí: một lần encode (~30ms).
# Đặt 0 để tắt hẳn (hệ thống về đúng hành vi single-turn của bản trước).
BAT_TRUY_VAN_NGU_CANH=1

# Cách thứ hai: nhờ LLM VIẾT LẠI câu nối tiếp thành câu độc lập (query rewriting kinh điển).
# MẶC ĐỊNH TẮT, và đây là KẾT QUẢ ÂM TÍNH ĐO ĐƯỢC (§5.58), không phải chưa làm xong:
#   qwen3:4b     0/7 ca - luôn sinh chuỗi suy luận dài trước khi trả lời (§5.23) nên tiêu hết
#                num_predict lúc "nghĩ" rồi trả về content RỖNG. Đủ chỗ thì cần ~3000 token,
#                tức ~30 giây cộng thêm mỗi câu nối tiếp - đắt hơn vấn đề nó giải quyết.
#   qwen2.5vl:3b Nhanh (không có chế độ suy luận) nhưng sai: chép y nguyên câu gốc, hoặc trả
#                về đúng câu hỏi CŨ.
# Bật lại nếu bạn đổi OLLAMA_MODEL sang model không sinh suy luận và đủ mạnh - rồi chạy
# `python evaluation/kiem_dinh_viet_lai.py` để tự kiểm trước khi tin.
BAT_VIET_LAI_CAU_HOI=0
NUM_PREDICT_VIET_LAI=200
# Số lượt hỏi-đáp gần nhất đưa vào prompt viết lại. Nhiều hơn không tốt hơn: với 6 lượt,
# model đã từng gộp chủ đề của lượt 1 vào câu hỏi đang hỏi về lượt 5.
SO_LUOT_NGU_CANH=3
# Cắt ngắn câu trả lời cũ khi đưa vào prompt - việc viết lại chỉ cần biết lượt trước NÓI VỀ
# CHỦ ĐỀ GÌ, còn toàn văn thì khiến model lôi chi tiết vụn của câu cũ vào câu hỏi mới.
DO_DAI_TRA_LOI_TRONG_NGU_CANH=300
# Bản viết lại dài hơn ngần này từ gần như luôn là model đã tự trả lời -> lùi về câu gốc.
SO_TU_TOI_DA_CAU_VIET_LAI=60
# Trọng số nhánh CÂU HỎI GỐC trong RRF (truy vấn chính luôn = 1.0). Chạy cả hai nhánh là
# chốt an toàn THEO CẤU TRÚC: truy vấn đã ghép ngữ cảnh là một PHỎNG ĐOÁN về ý người dùng,
# và giữ nhánh câu gốc khiến một lần ghép sai không thể xoá sạch kết quả đúng.
TRONG_SO_TRUY_VAN_GOC=1.0

# ============================================================
# ĐỐI CHIẾU CHÉO CÁC NGUỒN: phát hiện mâu thuẫn giữa các tài liệu
# ============================================================
# Hệ thống xử lý mỗi đoạn trích độc lập và không bao giờ hỏi "các đoạn này có nói ngược nhau
# không". Với tài liệu học tập thật thì chuyện đó xảy ra thường xuyên (giáo trình cũ và slide
# mới ghi khác con số, hai môn định nghĩa khác nhau cùng một khái niệm), và LLM sẽ lặng lẽ
# chọn một bên - người đọc mất đúng thông tin quan trọng nhất.
#
# Hai tầng như retrieval: lọc tất định (khác nguồn + cùng chủ đề + có dấu hiệu bất đồng) rồi
# mới cho LLM đọc kỹ vài cặp sống sót. Đại đa số câu hỏi không có cặp nào qua tầng 1.
# Bước này chạy SAU khi câu trả lời đã hiện xong nên không làm chậm chữ đầu tiên.
BAT_DOI_CHIEU_NGUON=1
# Chỉ đối chiếu cặp có cosine từ mức này trở lên - hai đoạn phải nói về CÙNG một chuyện thì
# mới mâu thuẫn được. Đo trên corpus thật: cặp cùng chủ đề khác nguồn 0.88-0.96, cặp chỉ tình
# cờ cùng được truy xuất 0.78-0.86.
NGUONG_COSINE_DOI_CHIEU=0.88
# Trần số cặp gửi lên LLM mỗi lượt hỏi - đây là chốt chặn CHI PHÍ. Không có nó, 6 đoạn từ 6
# nguồn khác nhau sinh ra 15 cặp = 15 lượt gọi LLM sau MỖI câu trả lời.
SO_CAP_DOI_CHIEU_TOI_DA=3
# Số lần chấm mỗi cặp; chỉ báo mâu thuẫn khi TẤT CẢ các lần đều nói có. Báo động giả ở đây
# làm người dùng mất niềm tin vào chính tài liệu của họ - tệ hơn hẳn việc bỏ sót (bỏ sót chỉ
# đưa hệ thống về đúng hành vi cũ). Đặt 1 để chạy nhanh hơn, chấp nhận nhiều báo động giả hơn.
SO_LAN_CHAM_MAU_THUAN=2
# Mức độ mâu thuẫn tối thiểu (0-1) để báo ra. Dưới mức này thường là hai cách diễn đạt khác
# nhau của cùng một ý.
NGUONG_MAU_THUAN=0.6
